# SQLite by default so the app runs with no infrastructure.
# For Postgres: change `provider` in prisma/schema.prisma to "postgresql" and
# point this at your database. Nothing else needs to change.
# Prisma 7 resolves this relative to the project root (v6 resolved it against
# the schema directory); ./prisma/dev.db keeps the file v6 created.
DATABASE_URL="file:./prisma/dev.db"

# Optional. Without a key the built-in heuristic engine does the scoring and
# drafting — deterministic, explainable, free, and fast enough to run inline on
# ingest. With a key, an LLM takes over and the heuristic result is passed in as
# a prior and used as the fallback if the model is slow, down or returns junk.
# Any OpenAI-compatible endpoint works.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=12000

# Billing (Stripe). Without these, the app runs fine but /api/billing/*
# returns 500s. Create prices in the Stripe dashboard (test mode first),
# then `stripe listen --forward-to localhost:3101/api/billing/webhook`.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SEAT_MONTHLY=
# STRIPE_PRICE_SEAT_ANNUAL=
