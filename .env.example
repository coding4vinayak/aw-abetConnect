# AbetConnect — local + deploy environment
#
# This file is the contract: every name here is read by `src/**` code and
# documented in the README. `scripts/check-docs.mjs` asserts both directions.
# Copy to `.env` and fill in real values for local dev; set the same names in
# the deploy provider's environment for a real run.

# ─── core ──────────────────────────────────────────────────────────────────────
# Postgres / SQLite connection string consumed by Prisma. Local dev defaults
# to `file:./dev.db` (see `prisma/schema.prisma` datasource block); set this
# to the provider's URL in a real deploy.
DATABASE_URL=

# 32-byte secret used to sign session tokens and invite codes. Generate with
# `openssl rand -base64 32`. Rotate by re-generating and re-deploying.
SESSION_SECRET=

# Public origin of this deployment. Used for building absolute URLs in emails
# and OAuth redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3101

# ─── optional LLM (see README §Intelligence) ──────────────────────────────────
# Set LLM_API_KEY to enable the model-backed scoring and drafting path; the
# heuristic result is passed as a prior and used as fallback on error. If the
# three names below are absent, the engine defaults are used. Any OpenAI-
# compatible endpoint works.

# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=12000
