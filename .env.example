# SQLite by default so the app runs with no infrastructure.
# For Postgres: change `provider` in prisma/schema.prisma to "postgresql" and
# point this at your database. Nothing else needs to change.
# Local Postgres via `docker compose up -d` (any Postgres 15+ works).
DATABASE_URL="postgresql://abetConnect:abetConnect@localhost:5432/abetConnect"

# Optional. Without a key the built-in heuristic engine does the scoring and
# drafting — deterministic, explainable, free, and fast enough to run inline on
# ingest. With a key, an LLM takes over and the heuristic result is passed in as
# a prior and used as the fallback if the model is slow, down or returns junk.
# Any OpenAI-compatible endpoint works.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=12000

# Billing (Stripe). Without these, the app runs fine but /api/billing/*
# returns 500s. Create prices in the Stripe dashboard (test mode first),
# then `stripe listen --forward-to localhost:3101/api/billing/webhook`.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SEAT_MONTHLY=
# STRIPE_PRICE_SEAT_ANNUAL=

# Email (optional). Without a provider, mail is written to the server log
# instead of sent — and signup marks addresses verified, because demanding a
# click on a link that can never arrive would lock every new account out of
# its own product. With a provider, verification is enforced at sign-in and
# account + billing mail goes out for real.
# RESEND_API_KEY=
# EMAIL_FROM="Abetworks <noreply@abetworks.in>"
# EMAIL_WEBHOOK_URL=            # alternative to Resend; same {from,to,subject,html,text} JSON
# EMAIL_WEBHOOK_TOKEN=          # sent as Authorization: Bearer to EMAIL_WEBHOOK_URL
# Optional: the product name the mail templates say. Defaults to abetConnect.
# PRODUCT_NAME=abetConnect
# The origin every mail link points at — set it in production or links land on localhost.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
